# --- Stripe ---
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Hostinger ---
HOSTINGER_API_TOKEN=xxxxxxxxxxxxxxxx
# Dominio base donde se crean los subdominios de cada cliente
BASE_DOMAIN=reservai.com.mx

# item_id del plan de VPS que le vendes al cliente
# se obtiene una sola vez con: hostinger billing catalog list
HOSTINGER_VPS_ITEM_ID=xxxxxxxx

# template_id del sistema operativo/imagen a instalar (ej. Ubuntu 22.04, o una imagen con Docker)
# se obtiene una sola vez con: hostinger vps templates list
HOSTINGER_TEMPLATE_ID=1001

# (opcional) id de un script post-instalacion ya subido en hPanel
# (instala docker, clona el repo del servicio, arranca el contenedor, etc.)
# se obtiene con: hostinger vps post-install-scripts list
HOSTINGER_POST_INSTALL_SCRIPT_ID=

# (opcional) tu llave publica SSH para poder entrar a cada VPS que se cree
HOSTINGER_ADMIN_SSH_PUBLIC_KEY="ssh-ed25519 AAAA... tu-llave"

# puerto donde corre este servidor
PORT=3000
